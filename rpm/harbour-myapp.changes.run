#!/bin/bash
# Dynamic RPM changelog, generated from git commit messages at build time.
#
# sfdk runs this before rpmbuild and uses its stdout as the %changelog section.
# It takes precedence over harbour-myapp.changes when both exist.
#
# Only lines matching "[tag] <past-tense description>" are picked up, e.g.
#
#     [app] Added pull-down menu to the first page.
#     [packaging] Bumped version to 0.2.
#
# Newest first: work since the last release tag, then the tagged releases.
# See: sfdk changelog --help

# Entries not reachable from any release tag: everything, until the first tag
# exists. This is the part that actually carries the changelog before v1.0.
sfdk-changelog --untagged-only

# Entries for tagged revisions, newest release first. Before the first tag this
# finds nothing and only warns on stderr, so it must not fail the build.
sfdk-changelog || true
